        "design",
        "-p",
        "4713",
        "-c-1",
        "--silent"
      ],
      "port": 4713
    },
    {
      "name": "trainlog",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "trainlog-phone",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:phone"
      ],
      "port": 5173
